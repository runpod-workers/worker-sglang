{
  "title": "SGLang",
  "description": "A fast serving framework for large language models and vision language models.",
  "type": "serverless",
  "category": "language",
  "iconUrl": "https://avatars.githubusercontent.com/u/147780389?v=4",
  "config": {
    "runsOn": "GPU",
    "containerDiskInGb": 100,
    "gpuIds": "ADA_24,AMPERE_24,ADA_32_PRO,ADA_48_PRO,AMPERE_48,ADA_80_PRO,AMPERE_80",
    "gpuCount": 1,
    "allowedCudaVersions": ["13.0", "12.9"],
    "env": [
      {
        "key": "MODEL_NAME",
        "input": {
          "name": "Model",
          "type": "huggingface",
          "description": "Hugging Face model name",
          "required": true
        }
      },
      {
        "key": "HF_TOKEN",
        "input": {
          "name": "Hugging Face Token",
          "type": "string",
          "description": "Hugging Face access token, required for gated and private models",
          "default": "",
          "required": false
        }
      },
      {
        "key": "TOOL_CALL_PARSER",
        "input": {
          "name": "Tool Call Parser",
          "type": "string",
          "description": "Defines the parser used to interpret tool call responses",
          "default": "",
          "required": false,
          "advanced": true,
          "options": [
            { "value": "apertus2509", "label": "apertus2509" },
            { "value": "cohere_command4", "label": "cohere_command4" },
            { "value": "deepseekv3", "label": "deepseekv3" },
            { "value": "deepseekv31", "label": "deepseekv31" },
            { "value": "deepseekv32", "label": "deepseekv32" },
            { "value": "deepseekv4", "label": "deepseekv4" },
            { "value": "gemma4", "label": "gemma4" },
            { "value": "gigachat3", "label": "gigachat3" },
            { "value": "glm", "label": "glm" },
            { "value": "glm45", "label": "glm45" },
            { "value": "glm47", "label": "glm47" },
            { "value": "gpt-oss", "label": "gpt-oss" },
            { "value": "hermes", "label": "hermes" },
            { "value": "hunyuan", "label": "hunyuan" },
            { "value": "inkling", "label": "inkling" },
            { "value": "interns1", "label": "interns1" },
            { "value": "kimi_k2", "label": "kimi_k2" },
            { "value": "kimi_k3", "label": "kimi_k3" },
            { "value": "lfm2", "label": "lfm2" },
            { "value": "llama3", "label": "llama3" },
            { "value": "mimo", "label": "mimo" },
            { "value": "minicpm5", "label": "minicpm5" },
            { "value": "minimax-m2", "label": "minimax-m2" },
            { "value": "minimax-m3", "label": "minimax-m3" },
            { "value": "mistral", "label": "mistral" },
            { "value": "poolside_v1", "label": "poolside_v1" },
            { "value": "pythonic", "label": "pythonic" },
            { "value": "qwen", "label": "qwen" },
            { "value": "qwen25", "label": "qwen25" },
            { "value": "qwen3_coder", "label": "qwen3_coder" },
            { "value": "step3", "label": "step3" },
            { "value": "step3p5", "label": "step3p5" },
            { "value": "trinity", "label": "trinity" }
          ]
        }
      },
      {
        "key": "REASONING_PARSER",
        "input": {
          "name": "Reasoning Parser",
          "type": "string",
          "description": "Defines the parser used to interpret reasoning traces",
          "default": "",
          "required": false,
          "advanced": true,
          "options": [
            { "value": "apertus2509", "label": "apertus2509" },
            { "value": "cohere_command4", "label": "cohere_command4" },
            { "value": "deepseek-r1", "label": "deepseek-r1" },
            { "value": "deepseek-v3", "label": "deepseek-v3" },
            { "value": "deepseek-v4", "label": "deepseek-v4" },
            { "value": "gemma4", "label": "gemma4" },
            { "value": "glm45", "label": "glm45" },
            { "value": "gpt-oss", "label": "gpt-oss" },
            { "value": "hunyuan", "label": "hunyuan" },
            { "value": "inkling", "label": "inkling" },
            { "value": "interns1", "label": "interns1" },
            { "value": "kimi", "label": "kimi" },
            { "value": "kimi_k2", "label": "kimi_k2" },
            { "value": "kimi_k3", "label": "kimi_k3" },
            { "value": "mimo", "label": "mimo" },
            { "value": "minimax", "label": "minimax" },
            {
              "value": "minimax-append-think",
              "label": "minimax-append-think"
            },
            { "value": "minimax-m3", "label": "minimax-m3" },
            { "value": "mistral", "label": "mistral" },
            { "value": "nemotron_3", "label": "nemotron_3" },
            { "value": "poolside_v1", "label": "poolside_v1" },
            { "value": "qwen3", "label": "qwen3" },
            { "value": "qwen3-thinking", "label": "qwen3-thinking" },
            { "value": "step3", "label": "step3" },
            { "value": "step3p5", "label": "step3p5" }
          ]
        }
      },
      {
        "key": "TOKENIZER_PATH",
        "input": {
          "name": "Tokenizer Path",
          "type": "string",
          "description": "Path of the tokenizer",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "TOKENIZER_MODE",
        "input": {
          "name": "Tokenizer Mode",
          "type": "string",
          "description": "Tokenizer mode",
          "default": "auto",
          "required": false,
          "options": [
            { "value": "auto", "label": "auto" },
            { "value": "slow", "label": "slow" }
          ],
          "advanced": true
        }
      },
      {
        "key": "LOAD_FORMAT",
        "input": {
          "name": "Load Format",
          "type": "string",
          "description": "Format of model weights to load",
          "default": "auto",
          "required": false,
          "options": [
            { "value": "auto", "label": "auto" },
            { "value": "pt", "label": "pt" },
            { "value": "safetensors", "label": "safetensors" },
            { "value": "npcache", "label": "npcache" },
            { "value": "dummy", "label": "dummy" }
          ],
          "advanced": true
        }
      },
      {
        "key": "DTYPE",
        "input": {
          "name": "Data Type",
          "type": "string",
          "description": "Data type for weights and activations",
          "default": "auto",
          "required": false,
          "options": [
            { "value": "auto", "label": "auto" },
            { "value": "half", "label": "half" },
            { "value": "float16", "label": "float16" },
            { "value": "bfloat16", "label": "bfloat16" },
            { "value": "float", "label": "float" },
            { "value": "float32", "label": "float32" }
          ],
          "advanced": true
        }
      },
      {
        "key": "CONTEXT_LENGTH",
        "input": {
          "name": "Context Length",
          "type": "number",
          "description": "Model's maximum context length",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "QUANTIZATION",
        "input": {
          "name": "Quantization",
          "type": "string",
          "description": "Quantization method",
          "default": "",
          "required": false,
          "options": [
            { "value": "awq", "label": "awq" },
            { "value": "awq_marlin", "label": "awq_marlin" },
            { "value": "bitsandbytes", "label": "bitsandbytes" },
            { "value": "compressed-tensors", "label": "compressed-tensors" },
            { "value": "fp8", "label": "fp8" },
            { "value": "gguf", "label": "gguf" },
            { "value": "gptq", "label": "gptq" },
            { "value": "gptq_marlin", "label": "gptq_marlin" },
            { "value": "marlin", "label": "marlin" },
            { "value": "modelopt_fp4", "label": "modelopt_fp4" },
            { "value": "modelopt_fp8", "label": "modelopt_fp8" },
            { "value": "mxfp4", "label": "mxfp4" },
            { "value": "w8a8_fp8", "label": "w8a8_fp8" },
            { "value": "w8a8_int8", "label": "w8a8_int8" }
          ],
          "advanced": true
        }
      },
      {
        "key": "SERVED_MODEL_NAME",
        "input": {
          "name": "Served Model Name",
          "type": "string",
          "description": "Override model name in API",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "CHAT_TEMPLATE",
        "input": {
          "name": "Chat Template",
          "type": "string",
          "description": "Chat template name or path",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "MEM_FRACTION_STATIC",
        "input": {
          "name": "Memory Fraction Static",
          "type": "number",
          "description": "Fraction of memory for static allocation",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "MAX_RUNNING_REQUESTS",
        "input": {
          "name": "Max Running Requests",
          "type": "number",
          "description": "Maximum number of running requests",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "MAX_TOTAL_TOKENS",
        "input": {
          "name": "Max Total Tokens",
          "type": "number",
          "description": "Maximum tokens in memory pool",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "CHUNKED_PREFILL_SIZE",
        "input": {
          "name": "Chunked Prefill Size",
          "type": "number",
          "description": "Max tokens in chunk for chunked prefill",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "MAX_PREFILL_TOKENS",
        "input": {
          "name": "Max Prefill Tokens",
          "type": "number",
          "description": "Max tokens in prefill batch",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "SCHEDULE_POLICY",
        "input": {
          "name": "Schedule Policy",
          "type": "string",
          "description": "Request scheduling policy",
          "default": "",
          "required": false,
          "options": [
            { "value": "lpm", "label": "LPM" },
            { "value": "random", "label": "Random" },
            { "value": "fcfs", "label": "FCFS" },
            { "value": "dfs-weight", "label": "DFS Weight" }
          ],
          "advanced": true
        }
      },
      {
        "key": "SCHEDULE_CONSERVATIVENESS",
        "input": {
          "name": "Schedule Conservativeness",
          "type": "number",
          "description": "Conservativeness of schedule policy",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "TENSOR_PARALLEL_SIZE",
        "input": {
          "name": "Tensor Parallel Size",
          "type": "number",
          "description": "Tensor parallelism size",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "STREAM_INTERVAL",
        "input": {
          "name": "Stream Interval",
          "type": "number",
          "description": "Streaming interval in token length",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "RANDOM_SEED",
        "input": {
          "name": "Random Seed",
          "type": "number",
          "description": "Random seed",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "LOG_LEVEL",
        "input": {
          "name": "Log Level",
          "type": "string",
          "description": "Logging level for all loggers",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "LOG_LEVEL_HTTP",
        "input": {
          "name": "HTTP Log Level",
          "type": "string",
          "description": "Logging level for HTTP server",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "API_KEY",
        "input": {
          "name": "API Key",
          "type": "string",
          "description": "API key for the server",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "FILE_STORAGE_PATH",
        "input": {
          "name": "File Storage Path",
          "type": "string",
          "description": "Path of file storage in backend",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "DATA_PARALLEL_SIZE",
        "input": {
          "name": "Data Parallel Size",
          "type": "number",
          "description": "Data parallelism size",
          "default": "",
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "LOAD_BALANCE_METHOD",
        "input": {
          "name": "Load Balance Method",
          "type": "string",
          "description": "Load balancing strategy",
          "default": "",
          "required": false,
          "options": [
            { "value": "round_robin", "label": "Round Robin" },
            { "value": "shortest_queue", "label": "Shortest Queue" }
          ],
          "advanced": true
        }
      },
      {
        "key": "SKIP_TOKENIZER_INIT",
        "input": {
          "name": "Skip Tokenizer Init",
          "type": "boolean",
          "description": "Skip tokenizer init",
          "default": false,
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "TRUST_REMOTE_CODE",
        "input": {
          "name": "Trust Remote Code",
          "type": "boolean",
          "description": "Allow custom models from Hub",
          "default": false,
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "LOG_REQUESTS",
        "input": {
          "name": "Log Requests",
          "type": "boolean",
          "description": "Log inputs and outputs of requests",
          "default": false,
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "SHOW_TIME_COST",
        "input": {
          "name": "Show Time Cost",
          "type": "boolean",
          "description": "Show time cost of custom marks",
          "default": false,
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "DISABLE_RADIX_CACHE",
        "input": {
          "name": "Disable Radix Cache",
          "type": "boolean",
          "description": "Disable RadixAttention for prefix caching",
          "default": false,
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "DISABLE_CUDA_GRAPH",
        "input": {
          "name": "Disable CUDA Graph",
          "type": "boolean",
          "description": "Disable cuda graph",
          "default": false,
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "DISABLE_OUTLINES_DISK_CACHE",
        "input": {
          "name": "Disable Outlines Disk Cache",
          "type": "boolean",
          "description": "Disable disk cache of outlines",
          "default": false,
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "ENABLE_TORCH_COMPILE",
        "input": {
          "name": "Enable Torch Compile",
          "type": "boolean",
          "description": "Optimize model with torch.compile",
          "default": false,
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "ENABLE_P2P_CHECK",
        "input": {
          "name": "Enable P2P Check",
          "type": "boolean",
          "description": "Enable P2P check for GPU access",
          "default": false,
          "required": false,
          "advanced": true
        }
      },
      {
        "key": "TRITON_ATTENTION_REDUCE_IN_FP32",
        "input": {
          "name": "Triton Attention Reduce in FP32",
          "type": "boolean",
          "description": "Cast Triton attention results to fp32",
          "default": false,
          "required": false,
          "advanced": true
        }
      }
    ]
  }
}
